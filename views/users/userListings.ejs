<% layout("/layouts/boilerplate") %>
<h3  class="row row-cols-lg-3 row-cols-md-2 row-cols-sm-1 mt-3">Listing &nbsp;publish &nbsp;  by  &nbsp;<%= user.username %> :)</h3>
<div class="row row-cols-lg-3 row-cols-md-2 row-cols-sm-1 mt-5">
  
    <% for(let listing of  userListings){ %>
    <a class="link" href="/listings/<%= listing._id %>" style="text-decoration: none !important;" >
      <div class="card col listing-card">
        <img
          src="<%= listing.image.url %>"
          style="height: 20rem"
          class="card-img-top"
          alt="..."
        />
        <div class="card-body">
          <p class="card-text">
            <b> <%= listing.title %></b> <br />
            &#8377;<%= listing.price ? listing.price.toLocaleString('en-IN') : 'N/A' %> / night
            <i class="text-info" style="display: none;"> 
              &nbsp; &nbsp;+18% GST: 
              &#8377;<%= listing.price ? Math.round(listing.price * 0.18).toLocaleString('en-IN') : 'N/A' %>
              <br/>
              <span class="gst-total" style="color: black;">
                Total: &#8377;<%= listing.price ? Math.round(listing.price * 1.18).toLocaleString('en-IN') : 'N/A' %> / night
              </span>
            </i>
          </p>

        </div>
      </div>
    </a>
    <% } %>
  </div>