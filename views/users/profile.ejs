<% layout("/layouts/boilerplate") %>

<style>
  :root {
    --primary-color: #2c3e50;
    --secondary-color: #34495e;
    --accent-color: #3498db;
    --success-color: #27ae60;
    --text-light: #7f8c8d;
    --border-light: #ecf0f1;
    --bg-light: #fafbfc;
    --shadow-light: 0 2px 10px rgba(0,0,0,0.06);
    --shadow-medium: 0 4px 20px rgba(0,0,0,0.08);
  }

  .profile-container {
    max-width: 800px;
    margin: 0 auto;
    padding: 2rem 1rem;
  }

  .profile-card {
    background: #ffffff;
    border-radius: 12px;
    box-shadow: var(--shadow-medium);
    border: 1px solid var(--border-light);
    overflow: hidden;
  }

  .profile-header {
    background: linear-gradient(135deg, var(--primary-color) 0%, var(--secondary-color) 100%);
    padding: 3rem 2rem 2rem;
    position: relative;
  }

  .profile-header::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    background: url('data:image/svg+xml,<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 100 100"><defs><pattern id="grid" width="10" height="10" patternUnits="userSpaceOnUse"><path d="M 10 0 L 0 0 0 10" fill="none" stroke="rgba(255,255,255,0.03)" stroke-width="1"/></pattern></defs><rect width="100" height="100" fill="url(%23grid)"/></svg>');
  }

  .profile-info {
    position: relative;
    z-index: 2;
  }

  .user-avatar span {
    color: #ffffff;
    font-size: 1.8rem;
    font-weight: 600;
    letter-spacing: 1px;
  }

  .user-name {
    color: black;
    font-size: 1rem;
    font-weight: 600;
    margin-bottom: 0.25rem;
    letter-spacing: -0.025em;
  }

  .user-email {
    color: rgba(255, 255, 255, 0.8);
    font-size: 0.95rem;
    margin-bottom: 0;
  }

  .profile-body {
    padding: 2.5rem 2rem;
  }

  .profile-section {
    margin-bottom: 2rem;
  }

  .profile-section:last-child {
    margin-bottom: 0;
  }

  .section-description {
    background: var(--bg-light);
    padding: 1.5rem;
    border-radius: 8px;
    border-left: 4px solid var(--accent-color);
    margin-bottom: 1.5rem;
  }

  .section-description p {
    color: var(--secondary-color);
    font-size: 0.95rem;
    line-height: 1.6;
    margin: 0;
  }

  .stats-container {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
    gap: 1.5rem;
  }

  .stat-card {
    background: #ffffff;
    border: 1px solid var(--border-light);
    border-radius: 8px;
    padding: 1.5rem;
    transition: all 0.2s ease;
    position: relative;
  }

  .stat-card:hover {
    box-shadow: var(--shadow-light);
    transform: translateY(-1px);
  }

  .stat-header {
    display: flex;
    align-items: center;
    margin-bottom: 0.75rem;
  }

  .stat-icon {
    width: 36px;
    height: 36px;
    border-radius: 6px;
    display: flex;
    align-items: center;
    justify-content: center;
    margin-right: 0.75rem;
    font-size: 1.1rem;
  }

  .stat-icon.superhost {
    background: linear-gradient(135deg, #f39c12, #e67e22);
    color: #ffffff;
  }

  .stat-icon.properties {
    background: linear-gradient(135deg, var(--accent-color), #2980b9);
    color: #ffffff;
  }

  .stat-icon.languages {
    background: linear-gradient(135deg, var(--success-color), #229954);
    color: #ffffff;
  }

  .stat-label {
    color: var(--text-light);
    font-size: 0.85rem;
    font-weight: 500;
    text-transform: uppercase;
    letter-spacing: 0.5px;
  }

  .stat-value {
    color: var(--primary-color);
    font-size: 1.25rem;
    font-weight: 700;
    margin-top: 0.25rem;
  }

  .divider {
    height: 1px;
    background: var(--border-light);
    border: none;
    margin: 2rem 0;
  }

  .badge {
    display: inline-flex;
    align-items: center;
    background: var(--success-color);
    color: #ffffff;
    padding: 0.25rem 0.75rem;
    border-radius: 20px;
    font-size: 0.75rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.5px;
    margin-top: 0.5rem;
  }

  .badge::before {
    content: '✓';
    margin-right: 0.25rem;
    font-weight: bold;
  }

  @media (max-width: 768px) {
    .profile-container {
      padding: 1rem;
    }
    
    .profile-header {
      padding: 2rem 1.5rem 1.5rem;
    }
    
    .profile-body {
      padding: 2rem 1.5rem;
    }
    
    .stats-container {
      grid-template-columns: 1fr;
    }
  }
</style>

<div class="profile-container">
  <div class="profile-card">
    
    <!-- Profile Header -->
    <div class="profile-header">
      <div class="profile-info">
        <div class="user-avatar">
          <span><%= user.username.charAt(0).toUpperCase() %></span>
        </div>
        <h1 class="user-name"><%= user.username %></h1>
        <p class="user-email"><%= user.email %></p>
        <div class="badge">Verified Host</div>
      </div>
    </div>

    <!-- Profile Body -->
    <div class="profile-body">
      
      <!-- Description Section -->
      <div class="profile-section">
        <div class="section-description">
          <p>Your Nestigo profile is an important part of every reservation. Create yours to help other hosts and guests get to know you.</p>
        </div>
      </div>

      <hr class="divider">

      <!-- Stats Section -->
      <div class="profile-section">
        <div class="stats-container">
          
          <div class="stat-card">
            <div class="stat-header">
              <div>
                <div class="stat-label">Host Status</div>
                <div class="stat-value">Superhost</div>
              </div>
            </div>
          </div>

          <div class="stat-card">
            <div class="stat-header">
              <div>
                <div class="stat-label">Properties Listed</div>
                <div class="stat-value"><%= listings.length %></div>
              </div>
            </div>
          </div>

          <div class="stat-card">
            <div class="stat-header">
              <div>
                <div class="stat-label">Languages</div>
                <div class="stat-value">English, Hindi</div>
              </div>
            </div>
          </div>

        </div>
      </div>

    </div>
  </div>
</div>
