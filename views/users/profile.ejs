<% layout("/layouts/boilerplate") %>


<div class="container mt-5 d-flex justify-content-center ">
    <div class="card shadow-sm p-3" style="max-width: 500px;">
      <div class="card-body">
        <h4 class="card-title mb-0"><%= user.username %></h4>
        <small class="text-muted"><%= user.email%></small>

        <hr>

        <p>Your Nestigo profile is an important part of every reservation. Create yours to help other hosts and guests get to know you.</p>

        <ul class="list-unstyled">
          <li><strong>Superhost:</strong> ⭐ Yes</li>
          <li><strong>Properties Listed:</strong><%= listings.length %></li>
          <li><strong>Languages:</strong> English, Hindi</li>
        </ul>
      </div>
    </div>
  </div>