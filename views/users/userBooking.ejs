<% layout("/layouts/boilerplate") %>

<div class="container mt-4">
    <h2 class="mb-4">Your Bookings</h2>
  
    <% if (bookings && bookings.length === 0) { %>
      <p>You have no bookings yet.</p>
    <% } else { %>
      <div class="row row-cols-lg-3 row-cols-md-2 row-cols-sm-1">
        <% for (let booking of bookings) { %>
          <div>
            <div class="card col listing-card m-2">
              <img
                src="<%= booking.listingId?.image?.url || 'https://via.placeholder.com/300x200?text=No+Image' %>"
                style="height: 20rem; object-fit: cover;"
                class="card-img-top"
                alt="Booking Image"
              />
              <div class="card-body">
                <p class="card-text">
                  <b><%= booking.listingId?.title || "Unknown Listing" %></b><br />
                  <small>
                    <strong>Check-in:</strong> <%= booking.checkIn ? booking.checkIn.toDateString() : 'N/A' %><br />
                    <strong>Check-out:</strong> <%= booking.checkOut ? booking.checkOut.toDateString() : 'N/A' %><br />
                    <strong>Status:</strong> <%= booking.paymentStatus || 'Pending' %>
                  </small>
                </p>
              </div>
            </div>
            <form method="POST" action="/booking/<%= booking._id %>?_method=DELETE">
                <button type="submit" class="cancel_booking mb-4 ">Cancel Booking</button>
              </form>
            </div>
        <% } %>
    <% } %>
  </div>

</div>