<% layout("/layouts/boilerplate") %>
<section class="booking-container ">
  <div class="booking-card mt-4">
    <h3 class="mt-2">Book Your Stay at <span><%= listing.title %></span> </h3>

    <div class="image-wrapper">
      <img src="<%= listing.image.url %>" alt="Listing Image" />
    </div>

    <form action="/book/<%= listing._id %>" method="POST">
      <!-- Dates -->
      <div class="form-grid-2">
        <div class="form-group">
          <label>Check-In Date</label>
          <input type="date" name="checkIn" required placeholder="dd-mm-yyyy" />
        </div>
        <div class="form-group">
          <label>Check-Out Date</label>
          <input type="date" name="checkOut" required />
        </div>
      </div>

      <!-- Guests -->
      <div class="form-grid-3">
        <div class="form-group">
          <label>Adults</label>
          <input type="number" name="guests[adults]" min="1" required />
        </div>
        <div class="form-group">
          <label>Children</label>
          <input type="number" name="guests[children]" min="0" />
        </div>
        <div class="form-group">
          <label>Infants</label>
          <input type="number" name="guests[infants]" min="0" />
        </div>
      </div>

      <!-- Room Type -->
      <div class="form-group">
        <label>Room Type</label>
        <select name="roomType">
          <option value="standard">Standard</option>
          <option value="deluxe">Deluxe</option>
          <option value="suite">Suite</option>
        </select>
      </div>

      <!-- Special Requests -->
      <div class="form-group">
        <label>Special Requests</label>
        <textarea name="specialRequests" placeholder="e.g., Need early check-in..."></textarea>
      </div>

      <!-- Total Price -->
      <div class="form-group">
        <label><%= listing.Price %></label>
        <input type="number" name="totalPrice" readonly required />
      </div>

      <button class="btn-hover color-9">Book Now</button>
    </form>
  </div>
</section>

<script>
  const checkInInput = document.querySelector('input[name="checkIn"]');
  const checkOutInput = document.querySelector('input[name="checkOut"]');
  const roomTypeSelect = document.querySelector('select[name="roomType"]');
  const totalPriceInput = document.querySelector('input[name="totalPrice"]');
  const adultsInput = document.querySelector('input[name="guests[adults]"]');
  const childrenInput = document.querySelector('input[name="guests[children]"]');

  const roomPrices = {
    standard: 1500,
    deluxe: 2500,
    suite: 4000,
  };

  function calculateTotalPrice() {
    const checkIn = new Date(checkInInput.value);
    const checkOut = new Date(checkOutInput.value);
    const roomType = roomTypeSelect.value;
    const adults = parseInt(adultsInput.value) || 0;
    const children = parseInt(childrenInput.value) || 0;
    const totalGuests = adults + children;

    if (isNaN(checkIn) || isNaN(checkOut) || checkOut <= checkIn || totalGuests < 1) {
      totalPriceInput.value = "";
      return;
    }

    const nights = Math.ceil((checkOut - checkIn) / (1000 * 60 * 60 * 24));
    let basePrice = nights * (roomPrices[roomType] || 0);

    // Add cost per guest beyond 2 guests
    if (totalGuests > 2) {
      const extraGuests = totalGuests - 2;
      basePrice += extraGuests * 500 * nights;
    }

    // Add 18% GST
    const gstAmount = basePrice * 0.18;
    const total = basePrice + gstAmount;

    totalPriceInput.value = Math.round(total);
  }

  [checkInInput, checkOutInput, roomTypeSelect, adultsInput, childrenInput].forEach(input => {
    input.addEventListener("change", calculateTotalPrice);
  });
</script>
