<% layout("/layouts/boilerplate") %>

<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css">

<div class="booking-container">
  <div class="booking-card">
    <div class="price-section">
      <div class="price"><%= Math.floor(listing.price) %></div>
      <div class="duration">for <span id="nights-count">1</span> nights</div>
    </div>

    <form method="POST" action="/listings/<%= listing._id %>/booking">
      <div class="form-section">
        <h2 class="form-title">Book Your Stay</h2>

        <div class="date-time-grid">
          <div class="input-group">
            <label for="checkIn" class="input-label"><i class="fa-regular fa-calendar-days"></i> CHECK-IN</label>
            <input 
              type="date" 
              class="input-field" 
              id="checkIn" 
              name="checkIn" 
              required
              min="<%= new Date().toISOString().split('T')[0] %>"
              value="<%= new Date().toISOString().split('T')[0] %>"
            >
          </div>
          <div class="input-group">
            <label for="checkOut" class="input-label"><i class="fa-regular fa-calendar-days"></i> CHECKOUT</label>
            <input 
              type="date" 
              class="input-field" 
              id="checkOut" 
              name="checkOut" 
              required
              min="<%= new Date(Date.now() + 86400000).toISOString().split('T')[0] %>"
              value="<%= new Date(Date.now() + 86400000).toISOString().split('T')[0] %>"
            >
            <span class="error-message" id="checkout-error">
              Check-Out must be after Check-In
            </span>
          </div>
        </div>

        <h3 class="section-title">Guests</h3>
        <div class="guests-grid">
          <div class="input-group">
            <label for="adults" class="input-label"><i class="fa-solid fa-user"></i> ADULTS</label>
            <input 
              type="number" 
              class="input-field" 
              id="adults" 
              name="guests[adults]" 
              min="1" 
              value="1" 
              required
            >
          </div>
          <div class="input-group">
            <label for="children" class="input-label"><i class="fa-solid fa-child"></i> CHILDREN</label>
            <input 
              type="number" 
              class="input-field" 
              id="children" 
              name="guests[children]" 
              min="0" 
              value="0" 
              required
            >
          </div>
        </div>

        <input type="hidden" name="paymentStatus" value="pending">
        <input type="hidden" name="totalPrice" id="totalPrice" value="<%= listing.price %>">

        <button type="submit" class="reserve-button">Reserve Now</button>
        <p class="disclaimer">You won't be charged yet</p>
      </div>
    </form>
  </div>
</div>


