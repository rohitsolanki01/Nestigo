<% layout("/layouts/boilerplate") %>


  <div class="container_faq">
    <h1>Help Center</h1>
    <p class="subtext">We're here to help you with everything from booking your stay to resolving account issues.</p>
    
    <div class="search-container">
      <input type="text" class="search-input" placeholder="Search help articles..." aria-label="Search help articles">
    </div>

    <!-- FAQ Sections -->
    <div class="faq-section">
      <h2>Booking Questions</h2>

      <div class="faq-item">
        <div class="faq-question">How do I book a stay on Nestigo?</div>
        <div class="faq-answer">
          <p>To book a stay, search for your desired location and dates, explore the listings, and click on the one that fits your needs. Select your check-in and check-out dates, review the details, and click "Reserve" to proceed with payment. Once done, you'll receive a confirmation email with your booking details.</p>
        </div>
      </div>

      <div class="faq-item">
        <div class="faq-question">Can I cancel or change my booking?</div>
        <div class="faq-answer">
          <p>Yes, Nestigo allows you to cancel or modify bookings through the “My Trips” section of your account. Depending on the host’s cancellation policy (Flexible, Moderate, or Strict), you may be eligible for a full or partial refund. Modifications must be made at least 24 hours before check-in.</p>
        </div>
      </div>
    </div>

    <div class="faq-section">
      <h2>Payments & Security</h2>

      <div class="faq-item">
        <div class="faq-question">What payment methods do you accept?</div>
        <div class="faq-answer">
          <p>We support all major credit and debit cards, as well as digital payment options like PayPal, Google Pay, Apple Pay, and UPI in supported regions. Payment is processed securely at the time of booking, and you’ll get a digital receipt instantly</p>
        </div>
      </div>

      <div class="faq-item">
        <div class="faq-question">Is my payment information secure?</div>
        <div class="faq-answer">
          <p>Absolutely. All transactions on Nestigo are encrypted using SSL and processed through PCI-DSS compliant gateways. We do not store your sensitive payment data on our servers. Your privacy and security are our top priorities.</p>
        </div>
      </div>
    </div>

    <div class="faq-section">
      <h2>Host Communication</h2>

      <div class="faq-item">
        <div class="faq-question">What if the host doesn't respond?</div>
        <div class="faq-answer">
          <p>If your host hasn’t replied within 24 hours, we recommend sending a follow-up through the Nestigo message system. If there's still no response, our support team can intervene to assist you with communication or offer alternatives if necessary</p>
        </div>
      </div>

      <div class="faq-item">
        <div class="faq-question">Can I contact a host before booking?</div>
        <div class="faq-answer">
          <p>Yes, Nestigo encourages open communication. Each listing includes a “Contact Host” option where you can send questions or requests directly. This helps you clarify doubts and ensure the property fits your needs before confirming the booking</p>
        </div>
      </div>
    </div>

    <div class="contact-support">
      <p>Need personalized help? Our support team is available 24/7.</p>
      <a href="/contactUs"><button class="contact-btn">Contact Support</button></a>         
    </div>
  </div>

  <script>
         document.addEventListener('DOMContentLoaded', () => {
      const faqItems = document.querySelectorAll('.faq-item');
      const searchInput = document.querySelector('.search-input');

      faqItems.forEach(item => {
        const question = item.querySelector('.faq-question');
        question.addEventListener('click', () => {
          faqItems.forEach(i => i !== item && i.classList.remove('active'));
          item.classList.toggle('active');
        });
      });

      searchInput.addEventListener('input', function () {
        const term = this.value.toLowerCase();
        faqItems.forEach(item => {
          const q = item.querySelector('.faq-question').textContent.toLowerCase();
          const a = item.querySelector('.faq-answer').textContent.toLowerCase();
          item.style.display = q.includes(term) || a.includes(term) ? 'block' : 'none';
        });
      });

      document.querySelectorAll('.suggestions span').forEach(tag => {
        tag.addEventListener('click', () => {
          searchInput.value = tag.textContent;
          searchInput.dispatchEvent(new Event('input'));
        });
      });
    });
  </script>

