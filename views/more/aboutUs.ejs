<% layout("/layouts/boilerplate") %>

<main class="container-fluid px-0">


  <section class="hero-clean d-flex align-items-center justify-content-center text-center">
    <div class="container">
      <h1 class="hero-title fw-bold mb-4">Welcome to Nestigo</h1>
      <p class="hero-text mb-3">
        At Nestigo, we believe travel isn't just about where you go — it's about where you stay, who you meet, and how you feel while you're there.
      </p>
      <p class="hero-text mb-3">
        We're reimagining short-term stays by putting people, culture, and comfort at the heart of every booking. Whether you're a solo traveler, a remote worker, or a family on vacation, Nestigo offers real homes with genuine connections — not just empty rooms.
      </p>
      <p class="hero-text">
        Trusted by thousands of guests and hosts across regions, our platform ensures safe, affordable, and unforgettable stays that go beyond expectations. Discover the joy of belonging — anywhere.
      </p>
    </div>
  </section>

  <div class="container">

    <section class="my-5">
      <h2 class="fw-bold text-center mb-4">Who We Are</h2>
      <div class="row align-items-center">
        <div class="col-md-6">
          <p class="text-muted">
            Nestigo isn’t just a stay platform — it’s a new way of thinking about travel. Born from a deep appreciation for diverse communities and warm hospitality, our mission is to connect humans through homestays that feel authentic and grounded.
          </p>
          <p class="text-muted">
            We empower hosts and enrich travelers. We simplify booking. And we deliver comfort, transparency, and care — from the moment you land to the moment you leave.
          </p>
        </div>
        <div class="col-md-6">
          <img src="accets/nestigoWorkCycle.png" class="img-fluid" alt="Nestigo Process">
        </div>
      </div>
    </section>


    <section class="py-5 text-center">
      <h2 class="fw-bold mb-3">Our Vision & Values</h2>
      <p class="text-muted mx-auto" style="max-width: 750px;">
        Our vision is to create a world where every traveler feels welcomed, and every host feels empowered. At Nestigo, we value authenticity, inclusion, simplicity, and security — all built into every interaction and every stay.
      </p>
    </section>

    
    <section class="row my-5">
      <div class="col-md-6">
        <h3 class="fw-bold">A Community, Not Just Customers</h3>
        <p class="text-muted">
          We're proud to foster a vibrant community of explorers, storytellers, and sharers. Our hosts go beyond hospitality to create meaningful moments. Our guests bring back more than souvenirs — they bring back stories, friendships, and fresh perspectives.
        </p>
      </div>
      <div class="col-md-6">
        <h3 class="fw-bold">Your Experience, Our Priority</h3>
        <p class="text-muted">
          From easy check-ins to verified reviews, we’ve designed every part of the Nestigo journey to put you first. No hidden fees. No surprises. Just smooth, soulful stays.
        </p>
      </div>
    </section>


    <section class="bg-light p-5 rounded-4 shadow-sm text-center my-5">
      <h2 class="fw-bold mb-4">Why People Love Nestigo</h2>
      <div class="row">
        <div class="col-md-3 mb-4">
          <i class="bi bi-shield-check fs-1 text-primary"></i>
          <h5 class="mt-3">Trust & Safety</h5>
          <p class="text-muted">We verify hosts, protect payments, and offer 24/7 support — because your peace of mind matters most.</p>
        </div>
        <div class="col-md-3 mb-4">
          <i class="bi bi-house-heart fs-1 text-success"></i>
          <h5 class="mt-3">Real Homes</h5>
          <p class="text-muted">From cozy studios to heritage homes, each space is personal, welcoming, and full of character.</p>
        </div>
        <div class="col-md-3 mb-4">
          <i class="bi bi-globe fs-1 text-warning"></i>
          <h5 class="mt-3">Global Culture</h5>
          <p class="text-muted">We champion local stories, diverse voices, and cross-cultural exchange through every stay.</p>
        </div>
        <div class="col-md-3 mb-4">
          <i class="bi bi-lightning fs-1 text-danger"></i>
          <h5 class="mt-3">Fast, Simple Booking</h5>
          <p class="text-muted">Book in seconds, modify with ease, and stay updated every step of the way with our modern tools.</p>
        </div>
      </div>
    </section>

   <section class="text-center my-5">
      <h3 class="fw-semibold">Ready to travel differently?</h3>
      <p class="text-muted">With Nestigo, you're not just visiting. You're arriving.</p>
        <a href="/listings" class="button btn-lg mt-3">
        Start Exploring <i class="bi bi-arrow-right ms-2"></i>
      </a>
    </section>

      
  </div>
</main>

