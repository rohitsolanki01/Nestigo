<link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.5/font/bootstrap-icons.css" rel="stylesheet">

<link
href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.6/dist/css/bootstrap.min.css"
rel="stylesheet"
integrity="sha384-4Q6Gf2aSP4eDXB8Miphtr37CMZZQ5oXLH2yaXMJ2w8e2ZtHTl7GptT4jmndRuHDT"
crossorigin="anonymous"
/>


<nav class="navbar navbar-expand-md bg-body-light border-bottom sticky-top">
  <div class="container-fluid">

    <a class="navbar-brand d-flex align-items-center" href="/listings">
      <img src="/accets/logo.png" alt="Logo" height="60" class="me-2">
    </a>


    <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNavAltMarkup"
      aria-controls="navbarNavAltMarkup" aria-expanded="false" aria-label="Toggle navigation">
      <span class="navbar-toggler-icon"></span>
    </button>


    <div class="collapse navbar-collapse" id="navbarNavAltMarkup">
      

      <div class="navbar-nav">
        <a class="nav-link" href="/listings">
          <i class="bi bi-globe-americas me-1"></i> Explore
        </a>
      </div>

         <div class="navbar-nav ms-auto">
          <form class="d-flex" role="search" action="/listings" method="GET">
            <input class="form-control me-2 serch-inp" type="search" 
              name="country" 
              placeholder="Search by country"
              value="<%= typeof country !== 'undefined' ? country : '' %>"
            />
            <button class="btn btn-search" type="submit"><i class="fa-solid fa-magnifying-glass"></i>Search</button>
          </form>
        </div>

 
      <div class="navbar-nav ms-auto">
        <a class="nav-link" href="/listings/new">
          <i class="bi bi-house-add me-1"></i> List Your Nest
        </a>

        <% if (!currentUser) { %>
          <a class="nav-link" href="/signup">
            <i class="bi bi-person-plus me-1"></i> <b>Sign Up</b>
          </a>
          <a class="nav-link" href="/login">
            <i class="bi bi-door-open me-1"></i> <b>Login</b>
          </a>
        <% } else { %>  
          <a class="nav-link" href="/logout">
            <i class="bi bi-box-arrow-right me-1"></i> <b>Log out</b>
          </a>
          <div class="nav-item dropdown ms-2">
  <a class="nav-link dropdown-toggle d-flex align-items-center" href="#" id="profileDropdown" role="button" data-bs-toggle="dropdown" aria-expanded="false">
   <i class="bi bi-person-circle fs-4 text-primary"></i> &nbsp;My Account
  </a>
  <ul class="dropdown-menu dropdown-menu-end" aria-labelledby="profileDropdown">
    <li><a class="dropdown-item" href="/user/<%= currentUser._id %>/listings"><i class="bi bi-house-door me-2"></i>My Listings</a></li>
    <li><a class="dropdown-item" href="/user/<%= currentUser._id %>/booking"><i class="bi bi-calendar2-check me-2"></i> My Booking </a></li>
    <li><a class="dropdown-item" href="/user/<%= currentUser._id %>"><i class="bi bi-person-lines-fill me-2"></i>Profile</a></li>
  </ul>
</div>

        <% } %>
      </div>
    </div>
  </div>
</nav>


