          <form class="d-flex" role="search" action="/listings" method="GET">
            <input class="form-control me-2 mobile-search-input" type="search" name="country" placeholder="Search destination" value="<%= typeof country !== 'undefined' ? country : '' %>">
            <button class="btn btn-outline-primary" type="submit">
              <i class="bi bi-search"></i>
            </button>
