            </a>
            
            <ul class="dropdown-menu dropdown-menu-end user-dropdown-menu" aria-labelledby="userMenuDropdown">
              <li class="dropdown-header">
                <div class="user-info">
                  <strong><%= currentUser.username || 'User' %></strong>
                  <small>Welcome back!</small>
