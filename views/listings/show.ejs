<% layout("/layouts/boilerplate") %>
<body>
  <div class="row mt-3">
    <div class="col-8 offset-3">

   
  <h3 class="mb-3"><%= listing.title %></h3>
  </div>
  <div class="card col-6 offset-3 listing-card">
    <img src="<%= listing.image.url %>" class="card-img-top show-img" alt="listing image">
    <div class="card-body">
      <p class="card-text">own by: <b><%= listing.owner.username %> </b></p>
      <p class="card-text"> <%= listing.description  %> <br> </p>
      <p class="card-text">&#8377;<%= listing.price ? listing.price.toLocaleString('en-IN') : 'N/A' %> / night <br></p>
      <p class="card-text"> <%= listing.location  %> <br></p>
      <p class="card-text">  <%= listing.country %></p>
    </div>
  </div>
  <% if(currentUser && listing.owner._id.equals(currentUser._id) ) {%>
  <div class="btns">
    <a href="/listings/<%=listing._id %>/edit">edit</a>
    <br>
    <form method="post"  action="/listings/<%= listing._id %>?_method=DELETE" >
      <button>delete</button>
    </form>
  </div>
  <% } %>

  <div class="col-6 offset-3 mt-3 mb-2">
    <% if(currentUser) {%>
    <h4>Leave a Review</h4>
    <hr>
    <form  class="form needs-validation"  method="post"  action="/listings/<%= listing._id %>/reviews" novalidate>
      <fieldset class="starability-heartbeat">
        <legend>Rating:</legend>
        <input type="radio" id="no-rate" class="input-no-rate" name="review[rating]" value="0" checked aria-label="No rating." />
        <input type="radio" id="first-rate1" name="review[rating]" value="1" />
        <label for="first-rate1" title="Terrible">1 star</label>
        <input type="radio" id="first-rate2" name="review[rating]" value="2" />
        <label for="first-rate2" title="Not good">2 stars</label>
        <input type="radio" id="first-rate3" name="review[rating]" value="3" />
        <label for="first-rate3" title="Average">3 stars</label>
        <input type="radio" id="first-rate4" name="review[rating]" value="4" />
        <label for="first-rate4" title="Very good">4 stars</label>
        <input type="radio" id="first-rate5" name="review[rating]" value="5" />
        <label for="first-rate5" title="Amazing">5 stars</label>
      </fieldset>
      <div class="mb-3 mt-3">
        <label for="comment" class="form-label">Comment</label>
        <textarea 
          name="review[comment]" 
          id="comment" 
          cols="30"
          rows="4"
          class="form-control" 
          required></textarea>
        <div class="invalid-feedback">Please enter your review</div>
      </div>

        <button class="review_btn">Submit</button>
      <% } %>
    </form>


    <hr>
    <% if(listing.reviews.length > 0){ %>
    <b><p>All Reviews</p></b>
    <div class="row row-cols-1 row-cols-sm-2 row-cols-md-3 g-3 mb-3">
      <% for(let review of listing.reviews) { %>
        <div class="col">
          <div class="card h-100 shadow-sm">
            <div class="card-body d-flex flex-column justify-content-between">
              <div>
                <h5 class="card-title">@<%= review.author.username %></h5>
           
                <div class="d-flex align-items-center gap-1 mt-2">
                  <% for (let i = 1; i <= 5; i++) { %>
                    <% if (i <= review.rating) { %>
                      <i class="fas fa-star text-warning"></i>
                    <% } else { %>
                      <i class="far fa-star text-warning"></i>
                    <% } %>
                  <% } %>
                </div>
                <p class="card-text"><%= review.comment %></p>             
              </div>
              <form method="post" action="/listings/<%= listing._id %>/reviews/<%= review._id %>?_method=DELETE">
                <button class="btn btn-sm btn-danger mt-2">Delete</button>
              </form>
            </div>
          </div>
        </div>
      <% } %>
    </div>
    <% } %>
    <div class="col-6 mt-3" >
      <h3>Where you’ll be</h3>
      <div id="map" class="map-container"></div>
        <div class="map-controls">
          <input id="location-input" type="text" value="<%= listing.location %>" placeholder="Enter or update location..."  class="mt-3 "/>
        </div>
    </div>
  
    </div>
  </div>

</div>
<script
  src="https://unpkg.com/leaflet@1.9.3/dist/leaflet.js"
  integrity="sha512-Dqm3h1Y4qiHUjbhxTuBGQsza0Tfppn53SHlu/uj1f+RT+xfShfe7r6czRf5r2NmllO2aKx+tYJgoxboOkn1Scg=="
  crossorigin=""
></script>

<script>
   const apiKey = "<%= geoapifyApiKey %>";
  let map, marker;

  const hotelIcon = L.icon({
    iconUrl: "https://cdn-icons-png.flaticon.com/512/3179/3179068.png",
    iconSize: [40, 40],
    iconAnchor: [20, 40],
    popupAnchor: [0, -36],
    className: "hotel-icon"
  });

  function createMap(lat, lon, label) {
    if (!map) {
      map = L.map("map", { zoomControl: false }).setView([lat, lon], 14);

      L.tileLayer(`https://maps.geoapify.com/v1/tile/osm-carto/{z}/{x}/{y}.png?apiKey=${apiKey}`, {
        attribution: '&copy; <a href="https://www.geoapify.com/">Geoapify</a>',
        maxZoom: 20
      }).addTo(map);
    } else {
      map.setView([lat, lon], 14);
    }

    if (marker) map.removeLayer(marker);

    marker = L.marker([lat, lon], { icon: hotelIcon, draggable: true }).addTo(map)
      .bindPopup(`<b>${label}</b>`).openPopup();

    // Drag updates address input
    marker.on("dragend", () => {
      const pos = marker.getLatLng();
      reverseGeocode(pos.lat, pos.lng);
    });
  }

  function geocodeAndRender(location) {
    fetch(`https://api.geoapify.com/v1/geocode/search?text=${encodeURIComponent(location)}&apiKey=${apiKey}`)
      .then(res => res.json())
      .then(data => {
        if (data.features.length) {
          const [lon, lat] = data.features[0].geometry.coordinates;
          createMap(lat, lon, location);
        } else {
          alert("Location not found");
        }
      });
  }

  function reverseGeocode(lat, lon) {
    fetch(`https://api.geoapify.com/v1/geocode/reverse?lat=${lat}&lon=${lon}&apiKey=${apiKey}`)
      .then(res => res.json())
      .then(data => {
        if (data.features.length) {
          document.getElementById("location-input").value = data.features[0].properties.formatted;
        }
      });
  }

  function locateUser() {
    navigator.geolocation.getCurrentPosition(
      (pos) => {
        // Sometimes the map may not show if the container is hidden or not rendered yet.
        // Ensure the map container is visible and properly sized before creating the map.
        const { latitude, longitude } = pos.coords;
        setTimeout(() => {
          reverseGeocode(latitude, longitude);
          createMap(latitude, longitude, "My Location");
        }, 100); // slight delay to ensure DOM is ready
      },
      () => alert("Permission denied or location unavailable")
    );
  }

  document.addEventListener("DOMContentLoaded", () => {
    const initialLocation = document.getElementById("location-input").value;
    geocodeAndRender(initialLocation);

    document.getElementById("update-map").addEventListener("click", () => {
      const locationText = document.getElementById("location-input").value;
      if (locationText) geocodeAndRender(locationText);
    });

    document.getElementById("locate-me").addEventListener("click", locateUser);
  });
</script>