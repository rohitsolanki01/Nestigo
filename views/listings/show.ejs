<% layout("/layouts/boilerplate") %>

<div class="listing-detail-page">
  <!-- Hero Section with Image -->
  <div class="hero-section">
    <div class="hero-image-container">
      <img src="<%= listing.image.url %>" class="hero-image" alt="<%= listing.title %>">
      <div class="hero-overlay">
        <div class="hero-content">
          <h1 class="hero-title"><%= listing.title %></h1>
          <div class="hero-location">
            <i class="fas fa-map-marker-alt"></i>
            <span><%= listing.location %>, <%= listing.country %></span>
          </div>
        </div>
      </div>
    </div>
  </div>

  <div class="main-content">
    <div class="content-grid">
      <!-- Left Content -->
      <div class="listing-info">
        <!-- Property Details Card -->
        <div class="info-card property-details">
          <div class="card-header">
            <h2>Property Details</h2>
          </div>
          <div class="card-content">
            <div class="owner-info">
              <div class="owner-avatar">
                <i class="fas fa-user-circle"></i>
              </div>
              <div class="owner-details">
                <p class="owner-label">Hosted by</p>
                <p class="owner-name"><%= listing.owner.username %></p>
              </div>
            </div>
            
            <div class="description">
              <p><%= listing.description %></p>
            </div>

            <div class="property-features">
              <div class="feature-item">
                <i class="fas fa-map-marker-alt"></i>
                <span><%= listing.location %></span>
              </div>
              <div class="feature-item">
                <i class="fas fa-globe"></i>
                <span><%= listing.country %></span>
              </div>
            </div>
          </div>
        </div>

        <!-- Reviews Section -->
        <div class="info-card reviews-section">
          <div class="card-header">
            <h2>Reviews</h2>
            <% if(listing.reviews.length > 0){ %>
              <span class="review-count">(<%= listing.reviews.length %> reviews)</span>
            <% } %>
          </div>
          
          <% if(currentUser) {%>
          <div class="add-review-section">
            <h3>Leave a Review</h3>
            <form class="review-form needs-validation" method="post" action="/listings/<%= listing._id %>/reviews" novalidate>
              <div class="rating-section">
                <label class="rating-label">Rating:</label>
                <div class="star-rating">
                  <fieldset class="starability-heartbeat">
                    <input type="radio" id="no-rate" class="input-no-rate" name="review[rating]" value="0" checked aria-label="No rating." />
                    <input type="radio" id="first-rate1" name="review[rating]" value="1" />
                    <label for="first-rate1" title="Terrible">1 star</label>
                    <input type="radio" id="first-rate2" name="review[rating]" value="2" />
                    <label for="first-rate2" title="Not good">2 stars</label>
                    <input type="radio" id="first-rate3" name="review[rating]" value="3" />
                    <label for="first-rate3" title="Average">3 stars</label>
                    <input type="radio" id="first-rate4" name="review[rating]" value="4" />
                    <label for="first-rate4" title="Very good">4 stars</label>
                    <input type="radio" id="first-rate5" name="review[rating]" value="5" />
                    <label for="first-rate5" title="Amazing">5 stars</label>
                  </fieldset>
                </div>
              </div>

              <div class="comment-section">
                <label for="comment" class="form-label">Your Review</label>
                <textarea 
                  name="review[comment]" 
                  id="comment" 
                  placeholder="Share your experience..."
                  class="review-textarea" 
                  required></textarea>
                <div class="invalid-feedback">Please enter your review</div>
              </div>

              <button type="submit" class="submit-review-btn">
                <i class="fas fa-paper-plane"></i>
                Submit Review
              </button>
            </form>
          </div>
          <% } %>

          <!-- Reviews List -->
          <div class="reviews-list">
            <% if(listing.reviews.length > 0){ %>
              <% for(let review of listing.reviews) { %>
                <div class="review-card">
                  <div class="review-header">
                    <div class="reviewer-info">
                      <div class="reviewer-avatar">
                        <i class="fas fa-user-circle"></i>
                      </div>
                      <div class="reviewer-details">
                        <h4>@<%= review.author.username %></h4>
                        <div class="review-rating">
                          <% for (let i = 1; i <= 5; i++) { %>
                            <i class="fas fa-star <%= i <= review.rating ? 'filled' : '' %>"></i>
                          <% } %>
                        </div>
                      </div>
                    </div>
                    <form method="post" action="/listings/<%= listing._id %>/reviews/<%= review._id %>?_method=DELETE" class="delete-review-form">
                      <button type="submit" class="delete-btn" onclick="return confirm('Delete this review?')">
                        <i class="fas fa-trash"></i>
                      </button>
                    </form>
                  </div>
                  <p class="review-comment"><%= review.comment %></p>
                </div>
              <% } %>
            <% } else { %>
              <div class="no-reviews">
                <i class="fas fa-comment-slash"></i>
                <p>No reviews yet. Be the first to review!</p>
              </div>
            <% } %>
          </div>
        </div>

        <!-- Map Section -->
        <div class="info-card map-section">
          <div class="card-header">
            <h2>Where you'll be</h2>
          </div>
          <div class="card-content">
            <div class="map-container">
              <div id="map"></div>
            </div>
            <p class="map-location">
              <i class="fas fa-map-marker-alt"></i>
              <%= listing.location %>
            </p>
          </div>
        </div>
      </div>


      <div class="booking-sidebar">
        <div class="booking-card">
          <div class="price-section">
            <div class="price-display">
              <span class="price-amount">₹<%= listing.price ? listing.price.toLocaleString('en-IN') : 'N/A' %></span>
              <span class="price-period">per night</span>
            </div>
          </div>

          <div class="booking-actions">
            <% if(currentUser && listing.owner._id.equals(currentUser._id)) { %>
              <div class="owner-actions">
                <p class="owner-notice">
                  <i class="fas fa-crown"></i>
                  You own this property
                </p>
                <a href="/listings/<%=listing._id %>/edit" class="action-btn edit-btn">
                  <i class="fas fa-edit"></i>
                  Edit Listing
                </a>
                <form method="post" action="/listings/<%= listing._id %>?_method=DELETE" onsubmit="return confirm('Are you sure you want to delete this listing?')">
                  <button type="submit" class="action-btn delete-btn">
                    <i class="fas fa-trash"></i>
                    Delete Listing
                  </button>
                </form>
              </div>
            <% } else { %>
              <form method="get" action="/booking/<%= listing._id %>" class="booking-form">
                <button type="submit" class="book-now-btn">
                  <i class="fas fa-calendar-check"></i>
                  <span>Book Now</span>
                  <div class="btn-shine"></div>
                </button>
              </form>
              
              <div class="booking-note">
                <i class="fas fa-shield-alt"></i>
                <span>Your booking is protected</span>
              </div>
            <% } %>
          </div>
        </div>


        <div class="quick-info-card">
          <h3>Property Highlights</h3>
          <div class="highlight-items">
            <div class="highlight-item">
              <i class="fas fa-home"></i>
              <span>Entire place</span>
            </div>
            <div class="highlight-item">
              <i class="fas fa-wifi"></i>
              <span>Free WiFi</span>
            </div>
            <div class="highlight-item">
              <i class="fas fa-parking"></i>
              <span>Free parking</span>
            </div>
            <div class="highlight-item">
              <i class="fas fa-times-circle"></i>
              <span>Free cancellation</span>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>

<!-- Keep original map script intact -->
<script src="https://unpkg.com/leaflet@1.9.3/dist/leaflet.js" integrity="sha512-Dqm3h1Y4qiHUjbhxTuBGQsza0Tfppn53SHlu/uj1f+RT+xfShfe7r6czRf5r2NmllO2aKx+tYJgoxboOkn1Scg==" crossorigin=""></script>

<script>
  const apiKey = "<%= geoapifyApiKey %>";
  let map, marker;

  const hotelIcon = L.icon({
    iconUrl: "https://cdn-icons-png.flaticon.com/512/3179/3179068.png",
    iconSize: [40, 40],
    iconAnchor: [20, 40],
    popupAnchor: [0, -36],
    className: "hotel-icon"
  });

  function initMap(lat = 20, lon = 78, zoom = 5) {
    map = L.map("map", { zoomControl: false }).setView([lat, lon], zoom);
    L.tileLayer(`https://maps.geoapify.com/v1/tile/osm-carto/{z}/{x}/{y}.png?apiKey=${apiKey}`, {
      attribution: '&copy; <a href="https://www.geoapify.com/">Geoapify</a>',
      maxZoom: 20
    }).addTo(map);
  }

  function updateMarker(lat, lon, label = "Location") {
    if (marker) {
      marker.setLatLng([lat, lon]);
    } else {
      marker = L.marker([lat, lon], { icon: hotelIcon, draggable: true }).addTo(map);
      marker.on("dragend", () => {
        const pos = marker.getLatLng();
        reverseGeocode(pos.lat, pos.lng);
      });
    }
    map.setView([lat, lon], 14);
    marker.bindPopup(`<b>${label}</b>`).openPopup();
  }

  function geocodeAndRender(location) {
    fetch(`https://api.geoapify.com/v1/geocode/search?text=${encodeURIComponent(location)}&apiKey=${apiKey}`)
      .then(res => res.json())
      .then(data => {
        if (data.features.length) {
          const [lon, lat] = data.features[0].geometry.coordinates;
          updateMarker(lat, lon, location);
        } else {
          alert("Location not found");
        }
      })
      .catch(err => console.error("Geocode Error:", err));
  }

  function reverseGeocode(lat, lon) {
    fetch(`https://api.geoapify.com/v1/geocode/reverse?lat=${lat}&lon=${lon}&apiKey=${apiKey}`)
      .then(res => res.json())
      .then(data => {
        if (data.features.length) {
          const formatted = data.features[0].properties.formatted;
          const locationInput = document.getElementById("location-input");
          if (locationInput) locationInput.value = formatted;
        }
      })
      .catch(err => console.error("Reverse Geocode Error:", err));
  }

  function locateUser() {
    if (!navigator.geolocation) {
      alert("Geolocation not supported.");
      return;
    }
    navigator.geolocation.getCurrentPosition(
      pos => {
        const { latitude, longitude } = pos.coords;
        reverseGeocode(latitude, longitude);
        updateMarker(latitude, longitude, "My Location");
      },
      () => alert("Permission denied or location unavailable")
    );
  }

  document.addEventListener("DOMContentLoaded", () => {
    const location = "<%= listing.location %>";
    initMap();
    if (location) {
      geocodeAndRender(location);
    }

    const updateBtn = document.getElementById("update-map");
    const locateBtn = document.getElementById("locate-me");

    if (updateBtn) {
      updateBtn.addEventListener("click", () => {
        const locationText = document.getElementById("location-input").value;
        if (locationText) geocodeAndRender(locationText);
      });
    }

    if (locateBtn) {
      locateBtn.addEventListener("click", locateUser);
    }
  });
</script>
