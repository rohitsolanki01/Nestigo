<% layout("/layouts/boilerplate") %>
<div class="container-fluid px-3 px-md-5">

  <div class="row mt-3">
    <div class="col-12 col-md-8 offset-md-2">
      <h3 class="fs-4 fs-md-3 mb-3"><%= listing.title %></h3>
    </div>

    <div class="card col-12 col-md-6 offset-md-3 listing-card mb-4">
      <img src="<%= listing.image.url %>" class="card-img-top show-img" alt="listing image">
      <div class="card-body">
        <p class="card-text">Owned by: <b><%= listing.owner.username %></b></p>
        <p class="card-text"><%= listing.description %></p>
        <p class="card-text">&#8377;<%= listing.price ? listing.price.toLocaleString('en-IN') : 'N/A' %> / night</p>
        <p class="card-text"><%= listing.location %></p>
        <p class="card-text"><%= listing.country %></p>
      </div>
    </div>

    <% if(currentUser && listing.owner._id.equals(currentUser._id)) { %>
      <div class="col-12 col-md-6 offset-md-3 d-flex flex-column gap-2 mb-4">
        <a href="/listings/<%=listing._id %>/edit" class="btn button w-50">Edit</a>
        <form method="post" action="/listings/<%= listing._id %>?_method=DELETE">
          <button class="btn button w-50">Delete</button>
        </form>
      </div>
    <% } %>

    <% if (!currentUser || !listing.owner._id.equals(currentUser._id)) { %>
      <div class="col-12 col-md-6 offset-md-3">
        <form method="get" action="/booking/<%= listing._id %>">
          <button class="button">Book Now</button>
        </form>
      </div>
    <% } %>

<div class="col-12 col-md-6 offset-md-3 mt-3 mb-4">
    <% if(currentUser) {%>
    <h4>Leave a Review</h4>
    <hr>
    <form  class="form needs-validation"  method="post"  action="/listings/<%= listing._id %>/reviews" novalidate>
      <fieldset class="starability-heartbeat">
        <legend>Rating:</legend>
        <input type="radio" id="no-rate" class="input-no-rate" name="review[rating]" value="0" checked aria-label="No rating." />
        <input type="radio" id="first-rate1" name="review[rating]" value="1" />
        <label for="first-rate1" title="Terrible">1 star</label>
        <input type="radio" id="first-rate2" name="review[rating]" value="2" />
        <label for="first-rate2" title="Not good">2 stars</label>
        <input type="radio" id="first-rate3" name="review[rating]" value="3" />
        <label for="first-rate3" title="Average">3 stars</label>
        <input type="radio" id="first-rate4" name="review[rating]" value="4" />
        <label for="first-rate4" title="Very good">4 stars</label>
        <input type="radio" id="first-rate5" name="review[rating]" value="5" />
        <label for="first-rate5" title="Amazing">5 stars</label>
      </fieldset>
      <div class="mb-3 mt-3">
        <label for="comment" class="form-label">Comment</label>
        <textarea 
          name="review[comment]" 
          id="comment" 
          cols="30"
          rows="4"
          class="form-control" 
          required></textarea>
        <div class="invalid-feedback">Please enter your review</div>
      </div>

        <button class="button">Submit</button>
      <% } %>
    </form>


    <hr>
    <% if(listing.reviews.length > 0){ %>
    <b><p>All Reviews</p></b>
    <div class="row row-cols-1 row-cols-sm-2 row-cols-md-3 g-3 mb-3">
      <% for(let review of listing.reviews) { %>
        <div class="col">
          <div class="card h-100 shadow-sm">
            <div class="card-body d-flex flex-column justify-content-between">
              <div>
                <h5 class="card-title">@<%= review.author.username %></h5>
           
                <div class="d-flex align-items-center gap-1 mt-2">
                  <% for (let i = 1; i <= 5; i++) { %>
                    <% if (i <= review.rating) { %>
                      <i class="fas fa-star text-warning"></i>
                    <% } else { %>
                      <i class="far fa-star text-warning"></i>
                    <% } %>
                  <% } %>
                </div>
                <p class="card-text"><%= review.comment %></p>             
              </div>
              <form method="post" action="/listings/<%= listing._id %>/reviews/<%= review._id %>?_method=DELETE">
                <button class="btn btn-sm btn-danger mt-2">Delete</button>
              </form>
            </div>
          </div>
        </div>
      <% } %>
    </div>
    <% } %>
    <div class="map-section-wrapper mt-4 mb-3 ">
      <h3 class="fw-bold text-left mb-3">Where you’ll be</h3>
      <div class="map-container ">
        <div id="map" style="height: 400px; width: 100%;border-radius: 10px;"></div>
      </div>
      <p class="text-left text-muted mt-2"><%= listing.location %></p>
    </div>
       
  </div>
</div>

<!-- Leaflet and Map Script -->
<script src="https://unpkg.com/leaflet@1.9.3/dist/leaflet.js" integrity="sha512-Dqm3h1Y4qiHUjbhxTuBGQsza0Tfppn53SHlu/uj1f+RT+xfShfe7r6czRf5r2NmllO2aKx+tYJgoxboOkn1Scg==" crossorigin=""></script>

<script>
  const apiKey = "<%= geoapifyApiKey %>";
  let map, marker;

  const hotelIcon = L.icon({
    iconUrl: "https://cdn-icons-png.flaticon.com/512/3179/3179068.png",
    iconSize: [40, 40],
    iconAnchor: [20, 40],
    popupAnchor: [0, -36],
    className: "hotel-icon"
  });

  function initMap(lat = 20, lon = 78, zoom = 5) {
    map = L.map("map", { zoomControl: false }).setView([lat, lon], zoom);
    L.tileLayer(`https://maps.geoapify.com/v1/tile/osm-carto/{z}/{x}/{y}.png?apiKey=${apiKey}`, {
      attribution: '&copy; <a href="https://www.geoapify.com/">Geoapify</a>',
      maxZoom: 20
    }).addTo(map);
  }

  function updateMarker(lat, lon, label = "Location") {
    if (marker) {
      marker.setLatLng([lat, lon]);
    } else {
      marker = L.marker([lat, lon], { icon: hotelIcon, draggable: true }).addTo(map);
      marker.on("dragend", () => {
        const pos = marker.getLatLng();
        reverseGeocode(pos.lat, pos.lng);
      });
    }
    map.setView([lat, lon], 14);
    marker.bindPopup(`<b>${label}</b>`).openPopup();
  }

  function geocodeAndRender(location) {
    fetch(`https://api.geoapify.com/v1/geocode/search?text=${encodeURIComponent(location)}&apiKey=${apiKey}`)
      .then(res => res.json())
      .then(data => {
        if (data.features.length) {
          const [lon, lat] = data.features[0].geometry.coordinates;
          updateMarker(lat, lon, location);
        } else {
          alert("Location not found");
        }
      })
      .catch(err => console.error("Geocode Error:", err));
  }

  function reverseGeocode(lat, lon) {
    fetch(`https://api.geoapify.com/v1/geocode/reverse?lat=${lat}&lon=${lon}&apiKey=${apiKey}`)
      .then(res => res.json())
      .then(data => {
        if (data.features.length) {
          const formatted = data.features[0].properties.formatted;
          const locationInput = document.getElementById("location-input");
          if (locationInput) locationInput.value = formatted;
        }
      })
      .catch(err => console.error("Reverse Geocode Error:", err));
  }

  function locateUser() {
    if (!navigator.geolocation) {
      alert("Geolocation not supported.");
      return;
    }
    navigator.geolocation.getCurrentPosition(
      pos => {
        const { latitude, longitude } = pos.coords;
        reverseGeocode(latitude, longitude);
        updateMarker(latitude, longitude, "My Location");
      },
      () => alert("Permission denied or location unavailable")
    );
  }

  document.addEventListener("DOMContentLoaded", () => {
    const location = "<%= listing.location %>";
    initMap();
    if (location) {
      geocodeAndRender(location);
    }

    const updateBtn = document.getElementById("update-map");
    const locateBtn = document.getElementById("locate-me");

    if (updateBtn) {
      updateBtn.addEventListener("click", () => {
        const locationText = document.getElementById("location-input").value;
        if (locationText) geocodeAndRender(locationText);
      });
    }

    if (locateBtn) {
      locateBtn.addEventListener("click", locateUser);
    }
  });
</script>
