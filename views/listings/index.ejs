<% layout("/layouts/boilerplate.ejs") %>
<body>
  <div id="filters" class="cols-3">
    <div class="filter">
      <a href="/listings?category=Trending"><i class="fa-solid fa-fire"></i><div>Trending</div></a>
    </div>

    <div class="filter">
      <a href="/listings?category=Rooms"><i class="fa-solid fa-bed"></i><div>Rooms</div></a>
    </div>

    <div class="filter">
      <a href="/listings?category=Iconic City"><i class="fa-solid fa-city"></i><div>Iconic City</div></a>
    </div>

    <div class="filter">
      <a href="/listings?category=Mountains"><i class="fa-solid fa-mountain"></i><div>Mountains</div></a>
    </div>

    <div class="filter">
      <a href="/listings?category=Castles"><i class="fa-solid fa-chess-rook"></i><div>Castles</div></a>
    </div>

    <div class="filter">
      <a href="/listings?category=Arctic"><i class="fa-solid fa-snowflake"></i><div>Arctic</div></a>
    </div>

    <div class="filter">
      <a href="/listings?category=Camping"><i class="fa-solid fa-campground"></i><div>Camping</div></a>
    </div>
    <div class="filter">
      <a href="/listings?category=Farms"><i class="fa-solid fa-wheat-awn"></i><div>Farms</div></a>
    </div>

    <div class="filter">
      <a href="/listings?category=Forest"><i class="fa-solid fa-tree"></i><div>Forest</div></a>
    </div>
    <div class="text-toggle">
      <div class="form-check-reverse form-switch">
        <input
          class="form-check-input "
          type="checkbox"
          role="switch"
          id="switchCheckDefault"
        />
        <label class="form-check-label" for="switchCheckDefault"
          >Display after tax</label
        >
      </div>
    </div>
  </div>

  <div class="row row-cols-lg-3 row-cols-md-2 row-cols-sm-1">
    <% for(let listing of allListings){ %>
    <a class="link" href="/listings/<%= listing._id %>">
      <div class="card col listing-card">
        <img
          src="<%= listing.image.url %>"
          style="height: 20rem"
          class="card-img-top"
          alt="..."
        />
        <div class="card-body">
          <p class="card-text">
            <b> <%= listing.title %></b> <br />
            &#8377;<%= listing.price ? listing.price.toLocaleString('en-IN') : 'N/A' %> / night
            <i class="text-info" style="display: none;"> 
              &nbsp; &nbsp;+18% GST: 
              &#8377;<%= listing.price ? Math.round(listing.price * 0.18).toLocaleString('en-IN') : 'N/A' %>
              <br/>
              <span class="gst-total" style="color: black;">
                Total: &#8377;<%= listing.price ? Math.round(listing.price * 1.18).toLocaleString('en-IN') : 'N/A' %> / night
              </span>
            </i>
          </p>

        </div>
      </div>
    </a>
    <% } %>
  </div>
</body>

<script>
  let textSwitch = document.getElementById("switchCheckDefault")
  textSwitch.addEventListener("click" , () => {
    let textInof = document.getElementsByClassName("text-info");
      for(let info of textInof) {
        if(info.style.display != "inline"){
          info.style.display  = "inline";
        }else{
          info.style.display  = "none";
        }
      }
  })
</script>