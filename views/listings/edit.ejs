<% layout("/layouts/boilerplate") %>

<div class="edit-listing-page">
  <div class="edit-container">
    <!-- Page Header -->
    <div class="page-header">
      <div class="header-content">
        <div class="header-icon">
          <i class="fas fa-edit"></i>
        </div>
        <div class="header-text">
          <h1>Edit Your Listing</h1>
          <p>Update your property details and make it shine</p>
        </div>
      </div>
      <div class="header-actions">
        <a href="/listings/<%= listing._id %>" class="view-btn">
          <i class="fas fa-eye"></i>
          View Listing
        </a>
      </div>
    </div>

    <!-- Edit Form -->
    <div class="form-content">
      <form class="professional-edit-form needs-validation" method="POST" action="/listings/<%= listing._id %>?_method=PUT" novalidate enctype="multipart/form-data">
        
        <!-- Basic Information Section -->
        <div class="form-section">
          <div class="section-header">
            <h2><i class="fas fa-info-circle"></i> Basic Information</h2>
            <p>Update your property details</p>
          </div>
          
          <div class="form-grid">
            <div class="form-group full-width">
              <label for="title" class="form-label">
                <span class="label-text">Property Title</span>
                <span class="label-required">*</span>
              </label>
              <div class="input-wrapper">
                <input 
                  type="text" 
                  id="title"
                  name="listing[title]" 
                  value="<%= listing.title %>"
                  class="form-control" 
                  required
                >
                <div class="input-icon">
                  <i class="fas fa-home"></i>
                </div>
              </div>
              <div class="invalid-feedback">Please enter a descriptive title for your property.</div>
            </div>

            <div class="form-group full-width">
              <label for="description" class="form-label">
                <span class="label-text">Description</span>
                <span class="label-required">*</span>
              </label>
              <div class="textarea-wrapper">
                <textarea 
                  id="description"
                  name="listing[description]" 
                  class="form-control textarea-large" 
                  required
                  rows="5"><%= listing.description %></textarea>
                <div class="textarea-counter">
                  <span class="char-count">0</span>/500
                </div>
              </div>
              <div class="invalid-feedback">Please provide a detailed description.</div>
            </div>
          </div>
        </div>

        <!-- Image Management Section -->
        <div class="form-section">
          <div class="section-header">
            <h2><i class="fas fa-camera"></i> Property Images</h2>
            <p>Update your property photos</p>
          </div>
          
          <!-- Current Image Preview -->
          <div class="current-image-section">
            <label class="form-label">
              <span class="label-text">Current Image</span>
            </label>
            <div class="current-image-container">
              <img src="<%= orignelImageUrl %>" alt="Current listing image" class="current-image" id="currentImage">
              <div class="image-overlay">
                <div class="image-info">
                  <i class="fas fa-image"></i>
                  <span>Current Photo</span>
                </div>
              </div>
            </div>
          </div>

          <!-- New Image Upload -->
          <div class="form-group full-width">
            <label for="image" class="form-label">
              <span class="label-text">Upload New Image</span>
              <span class="label-optional">(Optional)</span>
            </label>
            
            <div class="file-upload-area" id="fileUploadArea">
              <input type="file" name="listing[image][url]" id="image" class="file-input" accept="image/*">
              
              <!-- Default Upload Content -->
              <div class="upload-content" id="uploadContent">
                <div class="upload-icon">
                  <i class="fas fa-cloud-upload-alt"></i>
                </div>
                <div class="upload-text">
                  <h3>Replace with new image</h3>
                  <p>Drop image here or click to browse</p>
                </div>
                <button type="button" class="upload-btn">Choose New Photo</button>
              </div>
              
              <!-- Loading State -->
              <div class="upload-loading" id="uploadLoading" style="display: none;">
                <div class="upload-spinner">
                  <div class="spinner-ring"></div>
                  <div class="spinner-ring"></div>
                  <div class="spinner-ring"></div>
                </div>
                <div class="loading-text">
                  <h3>Processing new image...</h3>
                  <p>Please wait while we prepare your photo</p>
                </div>
                <div class="progress-bar-upload">
                  <div class="progress-fill-upload" id="uploadProgress"></div>
                </div>
              </div>
              
              <!-- New Image Preview -->
              <div class="file-preview" id="filePreview" style="display: none;">
                <div class="preview-image-container">
                  <img id="previewImage" src="" alt="New image preview">
                  <div class="preview-overlay">
                    <div class="preview-actions">
                      <button type="button" class="change-image-btn" id="changeImage">
                        <i class="fas fa-camera"></i>
                        Change
                      </button>
                      <button type="button" class="remove-file" id="removeFile">
                        <i class="fas fa-trash"></i>
                        Remove
                      </button>
                    </div>
                  </div>
                </div>
                <div class="file-info">
                  <div class="file-details">
                    <span class="file-name" id="fileName"></span>
                    <span class="file-size" id="fileSize"></span>
                  </div>
                  <div class="upload-status">
                    <i class="fas fa-check-circle"></i>
                    <span>Ready to Upload</span>
                  </div>
                </div>
              </div>
            </div>
            <div class="form-hint">Leave empty to keep current image, or upload a new one to replace it</div>
          </div>
        </div>

        <!-- Location & Pricing Section -->
        <div class="form-section">
          <div class="section-header">
            <h2><i class="fas fa-map-marker-alt"></i> Location & Pricing</h2>
            <p>Update location and pricing information</p>
          </div>
          
          <div class="form-grid">
            <div class="form-group">
              <label for="price" class="form-label">
                <span class="label-text">Price per Night</span>
                <span class="label-required">*</span>
              </label>
              <div class="input-wrapper price-input">
                <div class="currency-symbol">₹</div>
                <input 
                  type="number" 
                  id="price"
                  name="listing[price]" 
                  value="<%= listing.price %>"
                  class="form-control price-field" 
                  required
                  min="1"
                >
                <div class="price-suffix">per night</div>
              </div>
              <div class="invalid-feedback">Please enter a valid price.</div>
            </div>

            <div class="form-group">
              <label for="country" class="form-label">
                <span class="label-text">Country</span>
                <span class="label-required">*</span>
              </label>
              <div class="input-wrapper">
                <input 
                  type="text" 
                  id="country"
                  name="listing[country]" 
                  value="<%= listing.country %>"
                  class="form-control" 
                  required
                >
                <div class="input-icon">
                  <i class="fas fa-globe"></i>
                </div>
              </div>
              <div class="invalid-feedback">Please enter the country name.</div>
            </div>

            <div class="form-group full-width">
              <label for="location" class="form-label">
                <span class="label-text">City/Location</span>
                <span class="label-required">*</span>
              </label>
              <div class="input-wrapper">
                <input 
                  type="text" 
                  id="location"
                  name="listing[location]" 
                  value="<%= listing.location %>"
                  class="form-control" 
                  required
                >
                <div class="input-icon">
                  <i class="fas fa-map-marker-alt"></i>
                </div>
              </div>
              <div class="invalid-feedback">Please enter a valid location.</div>
            </div>
          </div>
        </div>

        <!-- Category Section -->
        <div class="form-section">
          <div class="section-header">
            <h2><i class="fas fa-tags"></i> Property Category</h2>
            <p>Select the most appropriate category</p>
          </div>
          
          <div class="form-group full-width">
            <label for="category" class="form-label">
              <span class="label-text">Category</span>
              <span class="label-required">*</span>
            </label>
            <div class="select-wrapper">
              <select name="listing[category]" id="category" class="form-select" required>
                <option value="Trending" <%= listing.category === 'Trending' ? 'selected' : '' %>>🔥 Trending</option>
                <option value="Rooms" <%= listing.category === 'Rooms' ? 'selected' : '' %>>🛏️ Rooms</option>
                <option value="Iconic City" <%= listing.category === 'Iconic City' ? 'selected' : '' %>>🏙️ Iconic City</option>
                <option value="Mountains" <%= listing.category === 'Mountains' ? 'selected' : '' %>>⛰️ Mountains</option>
                <option value="Castles" <%= listing.category === 'Castles' ? 'selected' : '' %>>🏰 Castles</option>
                <option value="Arctic" <%= listing.category === 'Arctic' ? 'selected' : '' %>>❄️ Arctic</option>
                <option value="Camping" <%= listing.category === 'Camping' ? 'selected' : '' %>>⛺ Camping</option>
                <option value="Farms" <%= listing.category === 'Farms' ? 'selected' : '' %>>🌾 Farms</option>
                <option value="Forest" <%= listing.category === 'Forest' ? 'selected' : '' %>>🌲 Forest</option>
              </select>
              <div class="select-icon">
                <i class="fas fa-chevron-down"></i>
              </div>
            </div>
            <div class="invalid-feedback">Please select a category.</div>
          </div>
        </div>

        <!-- Submit Section -->
        <div class="form-actions">
          <div class="action-buttons">
            <a href="/listings/<%= listing._id %>" class="cancel-btn">
              <i class="fas fa-times"></i>
              Cancel
            </a>
            <button type="submit" class="submit-btn">
              <span class="btn-content">
                <i class="fas fa-save"></i>
                Update Listing
              </span>
              <div class="btn-loader" style="display: none;">
                <div class="spinner"></div>
              </div>
            </button>
          </div>
        </div>
      </form>
    </div>
  </div>
</div>
